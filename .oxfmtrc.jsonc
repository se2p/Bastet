{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 120,
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "sortPackageJson": false,
    "ignorePatterns": [
        "docker.sh.inc",
        "LICENCE.md",
        "src/bastet/syntax/parser/grammar/*.ts",
        "src/lib/z3/libz3.so.js",
        "test/programs/**",
    ],
}
